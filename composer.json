{
  "name": "rabnawazak1/laravel-custom-softdelete",
  "description": "Custom soft delete with is_deleted, deleted_at, deleted_by",
  "type": "library",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Rabnawazak1\\CustomSoftDelete\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rabnawazak1\\CustomSoftDelete\\CustomSoftDeleteServiceProvider"
      ]
    }
  }
}